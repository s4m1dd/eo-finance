# ══════════════════════════════════════════════════════════════════════════
# EO Finance — Contoh konfigurasi environment.
#
# CARA PAKAI:
#   1. Copy file ini menjadi ".env"       →  cp .env.example .env
#   2. Isi nilai asli sesuai environment kamu (local/staging/production).
#   3. JANGAN PERNAH commit file ".env" ke git — sudah masuk .gitignore.
# ══════════════════════════════════════════════════════════════════════════

# ── Aplikasi ─────────────────────────────────────────────────────────────
APP_DEBUG=false
BASE_URL=http://localhost:8888/eo-finance

# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eo_finance
DB_USER=root
DB_PASS=
